# Copy this file to `.env` in the project root and edit.
#
# Precedence, lowest to highest:
#   1. built-in defaults        (config.py dataclasses)
#   2. config/default.yaml      ← put durable settings here
#   3. .env                     ← machine-specific overrides, not committed
#   4. real environment vars    ← a shell export always wins
#
# Only these three keys are read from the environment. Everything else —
# model paths, thresholds, chunk sizes — lives in config/default.yaml.

# Postgres connection. Change the port if 5432 was already taken and you
# remapped it in docker-compose.yml.
LAWRAG_DSN=postgresql://postgres:2006@localhost:5433/lawrag

# Path to the YAML config, if it is not config/default.yaml.
LAWRAG_CONFIG=config/default.yaml

# DEBUG shows per-branch retrieval counts, which is what you want when a query
# returns nothing and you need to know which branch came up empty.
LAWRAG_LOG_LEVEL=INFO

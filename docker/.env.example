# Copy this file to `docker/.env` (beside docker-compose.yml) and edit.
# Relative paths below resolve against docker/, not the repository root.
#
# This file has one job: telling `docker compose` about *this machine* — where
# the weights live, which host ports are free, which image target to build.
# It is read by compose itself, not by the application, and nothing in it is
# needed to run lawrag on another box.
#
# Application settings live in two places, in this order:
#   1. config/default.yaml   ← every durable knob, with the reasoning next to it
#   2. LAWRAG_<SECTION>_<FIELD> in the environment   ← deployment wiring, wins
#
# docker-compose.yml already sets the wiring variables (DSN, model paths,
# device, llm base_url), so in normal use you do not set any LAWRAG_* here.


# ----------------------------------------------------------------- build --
# models  — carries torch + FlagEmbedding, needed by the bge-m3 backends in
#           config/default.yaml. ~10 GB.
# runtime — everything except the weights stack (~390 MB). Enough for ingest,
#           retrieval over a hash embedder, the console, and a llama.cpp
#           generator reached over HTTP.
LAWRAG_TARGET=models

# Host directory holding bge-m3/, bge-reranker-v2-m3/ and the .gguf files.
# Mounted at /models in every container, so config/default.yaml never names a
# drive letter. Windows paths are fine here.
MODEL_DIR=../models


# ------------------------------------------------------------------ GPU --
# The base compose file runs everything on the CPU so that a machine without a
# card still works. For a GPU box, overlay docker-compose.gpu.yml — either per
# command (-f docker-compose.yml -f docker-compose.gpu.yml) or once, here:
#
#   COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
#   COMPOSE_PATH_SEPARATOR=;
#
# (on Linux/macOS the separator is ":"). The overlay puts the embedder on the
# card and leaves the reranker on the CPU; override per component if you want
# something else.
#EMBEDDING_DEVICE=cuda
#RERANK_DEVICE=cpu


# ------------------------------------------------------------ generator --
# Profile A — Qwen3.5-9B dense, fully on an 8 GB card, ~50 tok/s.
# Profile B — Qwen3.6-35B-A3B, MoE experts in RAM, ~30 tok/s (the default).
# docker/scripts/serve_llm.sh A|B sets these for you; set them here to make it stick.
#LLM_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
#LLM_N_CPU_MOE=28          # raise on VRAM OOM, lower for speed; 0 for a dense model
#LLM_GPU_LAYERS=999        # 0 to run the generator entirely on the CPU
#LLM_CTX_SIZE=32768


# ------------------------------------------------------------ Postgres --
# The password is the container's, set on first start. Changing it later needs
# the volume recreated (docker compose down -v) or an ALTER USER.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2006
POSTGRES_DB=lawrag


# ------------------------------------------------------- published ports --
# Host-side only, all bound to 127.0.0.1. Containers talk to each other by
# service name on the internal network and ignore these. 5433 because this
# workstation also runs a native PostgreSQL on 5432.
DB_HOST_PORT=5433
API_HOST_PORT=8000
LLM_HOST_PORT=8080


# ----------------------------------------------------------- app logging --
# DEBUG shows per-branch retrieval counts, which is what you want when a query
# returns nothing and you need to know which branch came up empty.
LAWRAG_LOG_LEVEL=INFO


# --------------------------------------------------------- access control --
# Required on every API/console request when set (Authorization: Bearer ...).
# Set it before publishing API_HOST_PORT on anything other than 127.0.0.1.
LAWRAG_API_TOKEN=
# 1 = accept imports without a token from outside the container's loopback.
# Safe only while the port is published on 127.0.0.1, as above.
LAWRAG_ALLOW_REMOTE_WRITES=1
